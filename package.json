{
  "name": "drivercom-gui",
  "type": "module",
  "scripts": {
    "prep": "panda codegen",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "drivercom-prepare": "mkdir -p src-tauri/binaries",
    "drivercom-fetch": "cd src-tauri/binaries && gh release download -R pmotionf/drivercom-cli -p '*-drivercom-cli-*.zip' --clobber",
    "drivercom-unpack": "pnpm node unpack-drivercom.js",
    "generate-config-types": "mkdir -p src-tauri/generated/config && pnpm node generate-drivercom-config.js",
    "drivercom": "pnpm run drivercom-prepare && pnpm run drivercom-fetch && pnpm run drivercom-unpack && pnpm run generate-config-types",
    "fetch-mmc-api": "mkdir -p src/proto && cd src/proto && gh release download -R pmotionf/mmc-api -A 'zip' --clobber",
    "unpack-mmc-api": "pnpm node unpack-mmcApi.js",
    "mmc-api": "pnpm fetch-mmc-api && pnpm run unpack-mmc-api && pnpm exec buf generate",
    "mmc-api-version": "mkdir -p src-tauri/generated && cd src-tauri/generated  && gh release -R pmotionf/mmc-api list --json name,tagName,publishedAt,isLatest > api.json",
    "pretauri": "pnpm run drivercom && pnpm run prep && pnpm run mmc-api-version && pnpm run mmc-api",
    "tauri": "tauri",
    "fmt": "pnpm prettier --write src",
    "fmt-check": "pnpm prettier --version && pnpm prettier --config .prettierrc.json --check src",
    "precheck": "pnpm run prep",
    "check": "pnpm eslint src && pnpm tsc",
    "test": "vitest"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.30.0",
    "@bufbuild/buf": "^1.65.0",
    "@bufbuild/protobuf": "^2.11.0",
    "@bufbuild/protoc-gen-es": "^2.11.0",
    "@dschz/solid-uplot": "^0.2.0",
    "@kuyoonjo/tauri-plugin-tcp": "^0.1.2",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@neodrag/solid": "^2.3.1",
    "@solid-primitives/deep": "^0.3.3",
    "@solidjs/router": "^0.15.4",
    "@tabler/icons-solidjs": "^3.36.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "~2.5.1",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "~2.4.2",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "json5": "^2.2.3",
    "lucide-solid": "^0.525.0",
    "park-ui": "^2.3.2",
    "solid-js": "^1.9.11",
    "tauri-pty": "^0.2.1",
    "udsv": "^0.7.3",
    "uplot": "^1.6.32",
    "xterm": "^5.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/css": "^0.9.0",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^0.12.0",
    "@pandacss/dev": "^0.54.0",
    "@park-ui/panda-preset": "^0.43.1",
    "@types/bun": "^1.3.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "prettier": "3.6.2",
    "typescript-eslint": "^8.54.0",
    "unzipper": "^0.12.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@tauri-apps/cli": "^2.6.2",
    "typescript": "^5.6.2",
    "vite-plugin-solid": "^2.11.7",
    "vite": "6.3.5"
  }
}
