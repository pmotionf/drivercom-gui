{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "args": true,
          "name": "binaries/drivercom",
          "sidecar": true
        },
        {
          "args": true,
          "name": "binaries/mmccli",
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "args": true,
          "name": "binaries/drivercom",
          "sidecar": true
        },
        {
          "args": true,
          "name": "binaries/mmccli",
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-kill",
      "allow": [
        {
          "args": true,
          "name": "binaries/drivercom",
          "sidecar": true
        },
        {
          "args": true,
          "name": "binaries/mmccli",
          "sidecar": true
        }
      ]
    },
    "pty:allow-spawn", "pty:default",
    "shell:allow-stdin-write",
    "shell:allow-open",
    "dialog:default",
    "fs:default",
    "fs:write-all",
    "tcp:default",
    "store:default",
    "fs:allow-read-dir",
    "fs:allow-write",
    "fs:allow-write-text-file",
    "fs:allow-appconfig-write",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**/*" }, {"path" : "$RESOURCES/**/*"},"$APPDATA/*"]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPDATA/**/*" }]
    },
    "fs:allow-appdata-write"  ]
}
